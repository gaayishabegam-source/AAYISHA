# =====================================================
# POCKETSMART AI CONFIGURATION
# =====================================================

# Gemini API key
GEMINI_API_KEY=


# Gemini model
#
# Keep this configurable.
# Use a model currently available to your Gemini API account.
#
GEMINI_MODEL=gemini-3.8-flash


# JWT secret
#
# Change this before production.
#
SECRET_KEY=replace-with-a-long-random-secret


# Database

DATABASE_URL=sqlite:///./pocketsmart.db


# Frontend / Backend origins

ALLOWED_ORIGINS_RAW=http://127.0.0.1:8000,http://localhost:8000


# Login token duration

TOKEN_EXPIRE_MINUTES=120